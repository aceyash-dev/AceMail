<?xml version="1.0" encoding="utf-8"?>
<!-- Ace Mail wearing amber, with the monogram as the mark.

     One of fifteen for this mark. The background is the same accent drawable
     the envelope icon uses — the switch changes the foreground and nothing
     else, which is what makes the two icons the same app rather than two
     designs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg_amber" />
    <foreground android:drawable="@drawable/ic_launcher_monogram" />
    <monochrome android:drawable="@drawable/ic_launcher_monogram_monochrome" />
</adaptive-icon>
