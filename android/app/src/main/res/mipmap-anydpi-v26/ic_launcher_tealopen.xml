<?xml version="1.0" encoding="utf-8"?>
<!-- Ace Mail wearing teal, with the open mark.

     The background is the accent drawable and the mark is the foreground, so
     the switch changes one layer and the accent stays what it is. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg_teal" />
    <foreground android:drawable="@drawable/ic_launcher_mark_open" />
    <monochrome android:drawable="@drawable/ic_launcher_mark_open_mono" />
</adaptive-icon>
