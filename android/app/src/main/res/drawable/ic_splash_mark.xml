<?xml version="1.0" encoding="utf-8"?>
<!-- The Ace Mail mark on its own, for the Android 12+ launch window.

     Separate from the launcher foreground because the splash sits on the app's
     own background, which is light in day mode and ink in night mode — see
     drawable-night/ic_splash_mark.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M34,38 L74,38 Q79,38 79,43 L79,65 Q79,70 74,70 L34,70 Q29,70 29,65 L29,43 Q29,38 34,38 Z"
        android:fillColor="@color/ace_orange" />

    <path
        android:pathData="M33,43 L54,58.5 L75,43"
        android:fillColor="#00000000"
        android:strokeColor="@color/ace_milk"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
