<?xml version="1.0" encoding="utf-8"?>
<!-- Ace Mail launcher foreground: an envelope, in orange.

     Adaptive icons are a 108dp canvas of which only the central 72dp is
     guaranteed visible, so the mark stays inside roughly 26..82 on both axes.
     The same geometry is drawn in-app by the BrandMark widget, so the launcher
     icon and the logo inside the app are the same mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- envelope body -->
    <path
        android:pathData="M34,40 L74,40 Q78,40 78,44 L78,68 Q78,72 74,72 L34,72 Q30,72 30,68 L30,44 Q30,40 34,40 Z"
        android:fillColor="#00000000"
        android:strokeColor="@color/ace_orange"
        android:strokeWidth="6.5"
        android:strokeLineJoin="round" />

    <!-- flap, seated on the body's top corner arcs so nothing protrudes -->
    <path
        android:pathData="M34,44 L54,59.5 L74,44"
        android:fillColor="#00000000"
        android:strokeColor="@color/ace_orange"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
