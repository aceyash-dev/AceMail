<?xml version="1.0" encoding="utf-8"?>
<!-- Ace Mail launcher foreground: the Ace "A" in orange.

     Adaptive icons are a 108dp canvas of which only the central 72dp is
     guaranteed visible, so the mark is kept inside roughly 26..82 on both
     axes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M38,80 L54,28 L70,80"
        android:fillColor="#00000000"
        android:strokeColor="@color/ace_orange"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M43.2,63 L64.8,63"
        android:fillColor="#00000000"
        android:strokeColor="@color/ace_orange"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
</vector>
