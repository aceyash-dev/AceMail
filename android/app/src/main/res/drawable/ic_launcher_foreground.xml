<?xml version="1.0" encoding="utf-8"?>
<!-- Ace Mail launcher foreground: the filled envelope, in orange.

     This is the same geometry the in-app BrandMark draws, on the same 108-unit
     grid, so the launcher icon and the logo inside the app are one mark rather
     than two similar ones.

     Adaptive icons are a 108dp canvas of which only the central 72dp is
     guaranteed visible, so the mark stays inside 29..79 on both axes.

     The flap is cut out in the icon background colour, so it must match the
     adaptive-icon background below. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- envelope body, filled -->
    <path
        android:pathData="M34,38 L74,38 Q79,38 79,43 L79,65 Q79,70 74,70 L34,70 Q29,70 29,65 L29,43 Q29,38 34,38 Z"
        android:fillColor="@color/ace_orange" />

    <!-- flap, cut out of the body so it reads at 48dp -->
    <path
        android:pathData="M33,43 L54,58.5 L75,43"
        android:fillColor="#00000000"
        android:strokeColor="@color/ace_milk"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
