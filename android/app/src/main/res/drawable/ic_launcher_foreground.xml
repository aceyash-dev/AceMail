<?xml version="1.0" encoding="utf-8"?>
<!-- Ace Mail launcher foreground: the mailbox, in the accent orange.

     A postbox with its flag up and a letter at the front. The envelope's flap is
     a real notch — the second subpath is subtracted with evenOdd — so the tile
     shows through rather than the mark carrying a flap-coloured stroke.

     Adaptive icons are a 108dp canvas of which only the central 72dp is
     guaranteed visible, so the mark stays inside 26..80. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- post -->
    <path
        android:pathData="M48,68 L52,68 L52,80 L48,80 Z M58,68 L62,68 L62,80 L58,80 Z"
        android:fillColor="@color/ace_orange" />

    <!-- body -->
    <path
        android:pathData="M38,68 L38,54 Q38,40 52,40 L62,40 Q76,40 76,54 L76,68 Z"
        android:fillColor="@color/ace_orange" />

    <!-- flag -->
    <path
        android:pathData="M64,28 L68,28 L68,44 L64,44 Z M68,28 L78,28 L78,36 L68,36 Z"
        android:fillColor="@color/ace_orange" />

    <!-- a hairline of background behind the letter, so it reads as being in
         front of the box rather than part of it -->
    <path
        android:pathData="M28,49 L48,49 Q53,49 53,54 L53,66 Q53,71 48,71 L28,71 Q23,71 23,66 L23,54 Q23,49 28,49 Z"
        android:fillColor="@color/ace_milk" />

    <!-- the letter, with its flap cut out -->
    <path
        android:pathData="M30,52 L46,52 Q50,52 50,56 L50,64 Q50,68 46,68 L30,68 Q26,68 26,64 L26,56 Q26,52 30,52 Z M29,55 L38,63 L47,55 Z"
        android:fillColor="@color/ace_orange"
        android:fillType="evenOdd" />
</vector>
