<?xml version="1.0" encoding="utf-8"?>
<!-- Ace Mail launcher foreground: a filled envelope, in orange.

     Adaptive icons are a 108dp canvas of which only the central 72dp is
     guaranteed visible, so the mark stays inside roughly 26..82 on both axes.
     The flap is cut out in the background colour, and the same geometry is
     drawn in-app by EnvelopePainter, so the launcher icon and the logo inside
     the app are the same mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- solid envelope body -->
    <path
        android:pathData="M34,40 L74,40 Q78,40 78,44 L78,68 Q78,72 74,72 L34,72 Q30,72 30,68 L30,44 Q30,40 34,40 Z"
        android:fillColor="@color/ace_orange" />

    <!-- flap, cut in the background colour -->
    <path
        android:pathData="M33,43.5 L54,59 L75,43.5"
        android:fillColor="#00000000"
        android:strokeColor="@color/ace_milk"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
