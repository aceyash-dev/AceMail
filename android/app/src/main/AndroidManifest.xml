<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ace Mail talks to your mail provider directly over IMAP/SMTP, so it
         needs network access. Flutter's template only declares this for debug
         and profile builds, which is why a release build fails with
         "Failed host lookup ... errno = 7" without it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 and up asks before an app may post a notification. Asked for
         at the point the setting is turned on, not on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The background check needs to survive the device sleeping. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The address book, for the Contacts tab. Read only: the app imports
         addresses into its own list and never writes back to the device. Asked
         for when somebody taps Import in Contacts, never at launch. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:label="Ace Mail"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Ace Mail"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Being an email client. Without these the app can read mail but
                 cannot be the thing a mailto: link opens, which is most of what
                 "mail client" means to the system. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="message/rfc822" />
            </intent-filter>
        </activity>

        <!-- The launcher entry, one alias per accent.
             
             A launcher icon cannot be changed from an app setting, so the app
             ships fifteen of them and points the launcher at one: exactly one
             alias is enabled at a time, the orange one by default, and
             MainActivity itself carries no launcher filter at all. That is why
             a bad switch can never leave the app with no icon — the worst case
             is two, and the code enables the new alias before it disables the
             old ones. -->

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />


























































