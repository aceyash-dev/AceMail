PORT=8080
# Exact web OAuth client ID used by the Flutter Web build.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Base64-encoded 32 random bytes. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Exact deployed frontend origin, e.g. https://aceyash-dev.github.io
WEB_ORIGIN=https://aceyash-dev.github.io
# Put this on a persistent disk in production.
DATABASE_PATH=./data/ace-mail-web.sqlite
